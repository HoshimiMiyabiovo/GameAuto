# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# Virtual environment
.venv/
venv/
env/

# Sensitive user config (contains tokens, cookies, paths)
app_config.json
app_config.json.bak*
*.tmp_*

# Local flow config: GUI 会写个人开关（close_process_on_finish/enabled），不提交；
# 共享默认流程定义在 flow_configs.example.json，首次运行自动复制。
flow_configs.json

# Runtime data（2026-10-29 起统一在 data/：logs / artifacts / cache / workflow.sqlite3）
# 注意：不能直接写 /data/——父目录被整体忽略后 git 不再下钻，子目录的 ! 例外失效。
# 改用逐级排除：只忽略 data/ 下的运行时目录，其余（模型）正常跟踪。
/data/logs/
/data/artifacts/
/data/cache/
/data/backups/
/data/okww/
/data/okhna/
/data/reference/
# AI 对话史 RAG 库（tools/ai_history_rag.py 生成）：含全部历史对话正文，
# 用户 2026-11-08 拍板**永不可进远端**——删掉本行前先想清楚。
/data/ai_history/
/data/*.sqlite3
/data/*.sqlite3.*
/data/*.bak*
/data/*.log
# 但 OCR 引擎模型必须入库：换机 clone 即跑，否则 onnxocr v6 拿不到模型
# 返回空、整个文字定位链路失效（2026-11-07 用户拍板）。模型来自 OneDragon
# fork 的 OnnxOCR（Apache-2.0），来源与许可见 src/onnxocr/readme.md。
# 注意：不能写 /data/models/（父目录被整体忽略后 ! 例外失效，同 /data/ 陷阱），
# 只能逐文件忽略已下线引擎的模型，放行在用的 v6 与 flash_classifier。
/data/models/ch_PP-OCRv4_det_server.onnx
/data/models/ch_PP-OCRv4_rec_server.onnx
/data/models/onnx_ocr/ppocrv5/
# 兼容旧版本残留（迁移脚本执行前的目录）
logs/
artifacts/
*.log

# Test / lint caches（配置已重定向到 data/cache，这里兜底旧版本）
.pytest_cache/
.ruff_cache/
# QML 离屏测试产生的临时截图目录
.screenshots/

# Database
*.sqlite3
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
desktop.ini
.DS_Store

# Reference / temp code not part of project（参考项目副本在 data/reference/，data/ 已整体忽略）
.trae/
.claude/
.workbuddy/

# Tesseract OCR binaries (bundled separately)
tools/tesseract/

# Flet SDK (large, bundled separately)
tools/flet/

# Tesseract installer binary
tools/tesseract-installer.exe

# 受保护点击序列备份（运行时生成，用于误删恢复）
assets/click_sequences/.protected_backup/
# 终末地森空岛查询结果本地缓存（含用户游戏数据，不入库）
storage/cache/

# ZCode 会话工作目录（agent 运行时产物，不入库）
.zcode/

# Perch MCP 项目笔记（工具自动生成，不入库）
.perch/
# CodeArts Agent 本地工具状态目录（2026-11-16 出现在根目录，纯会话配置不入库）
.arts/
.codeartsdoer/

# SQLite WAL/SHM 运行时残留（主库 *.sqlite3 已在 /data/ 忽略；-wal/-shm 是
# 连字符后缀而非点号，/data/*.sqlite3.* 匹配不到，补一刀兜住任意位置）
*.sqlite3-wal
*.sqlite3-shm

# 测试临时目录兜底（2026-11-16：tempfile.mkdtemp/pytest tmp_path 在 TMP 环境变量
# 缺失时会落到 cwd，跑几轮全量就在项目根堆 tmp*/ 和 pytest-of-*/；套件侧已修
# 清理，这里再兜一层防误提交）
/tmp*/
/pytest-of-*/

# Trae 分享会话抓取产物（含聊天正文，按 2026-11-17 changelog 约定落 data/ 不入库）
/data/trae_capture/
/tools/trae_capture/share_links.txt

# 妙手（CatPaw）本地会话导出（含聊天正文，不入库）
/data/catpaw_capture/

# Kilo Desktop 本地会话导出（含聊天正文与内核 API 密码，不入库）
/data/kilo_capture/

# TeleAgent 本地会话导出（含聊天正文，不入库）
/data/teleagent_capture/

# 码道（CodeArts Agent）内核会话导出（含聊天正文，不入库）
/data/codearts_capture/

# DSH NEXT 本地会话导出（含聊天正文，不入库）
/data/dsh_capture/
/data/raccoon_capture/
# 千问办公（QwenWork）本地会话导出（含聊天正文，不入库）
/data/qwenwork_capture/
# 工作区根 _tmp_* 取证/探针脚本与缓存快照（2026-11-17 Kilo 排查产物，防误提交）
/_tmp_*

# 一次性任务临时区与会件临时目录兜底（2026-11-17 用户拍板：根目录禁止堆临时产物，
# 用完即删；.temp 允许存在但永不入库，套件临时目录前缀 ga_* 同样不入库）
/.temp/
/ga_*/
