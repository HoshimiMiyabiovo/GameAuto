# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# Virtual environment
.venv/
venv/
env/

# Sensitive user config (contains tokens, cookies, paths)
app_config.json
app_config.json.bak*
*.tmp_*

# Local flow config: GUI 会写个人开关（close_process_on_finish/enabled），不提交；
# 共享默认流程定义在 flow_configs.example.json，首次运行自动复制。
flow_configs.json

# Runtime data（2026-10-29 起统一在 data/：logs / artifacts / cache / workflow.sqlite3）
# 注意：不能直接写 /data/——父目录被整体忽略后 git 不再下钻，子目录的 ! 例外失效。
# 改用逐级排除：只忽略 data/ 下的运行时目录，其余（模型）正常跟踪。
/data/logs/
/data/artifacts/
/data/cache/
/data/backups/
/data/okww/
/data/reference/
/data/*.sqlite3
/data/*.sqlite3.*
/data/*.bak*
/data/*.log
# 但 OCR 引擎模型必须入库：换机 clone 即跑，否则 onnxocr v6 拿不到模型
# 返回空、整个文字定位链路失效（2026-11-07 用户拍板）。模型来自 OneDragon
# fork 的 OnnxOCR（Apache-2.0），来源与许可见 src/onnxocr/readme.md。
# 注意：不能写 /data/models/（父目录被整体忽略后 ! 例外失效，同 /data/ 陷阱），
# 只能逐文件忽略已下线引擎的模型，放行在用的 v6 与 flash_classifier。
/data/models/ch_PP-OCRv4_det_server.onnx
/data/models/ch_PP-OCRv4_rec_server.onnx
/data/models/onnx_ocr/ppocrv5/
# 兼容旧版本残留（迁移脚本执行前的目录）
logs/
artifacts/
*.log

# Test / lint caches（配置已重定向到 data/cache，这里兜底旧版本）
.pytest_cache/
.ruff_cache/
# QML 离屏测试产生的临时截图目录
.screenshots/

# Database
*.sqlite3
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
desktop.ini
.DS_Store

# Reference / temp code not part of project（参考项目副本在 data/reference/，data/ 已整体忽略）
.trae/
.claude/
.workbuddy/

# Tesseract OCR binaries (bundled separately)
tools/tesseract/

# Flet SDK (large, bundled separately)
tools/flet/

# Tesseract installer binary
tools/tesseract-installer.exe

# 受保护点击序列备份（运行时生成，用于误删恢复）
assets/click_sequences/.protected_backup/
# 终末地森空岛查询结果本地缓存（含用户游戏数据，不入库）
storage/cache/

# ZCode 会话工作目录（agent 运行时产物，不入库）
.zcode/
